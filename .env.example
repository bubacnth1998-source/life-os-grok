# LIFE OS — copy to .env and fill values

LIFE_OS_ENV=production
LIFE_OS_DEBUG=false
LIFE_OS_SECRET_KEY=replace-with-long-random-secret-at-least-32-chars

# SQLite (default) or PostgreSQL
# DATABASE_URL=sqlite:////data/lifeos.db
# DATABASE_URL=postgresql+psycopg2://lifeos:password@localhost:5432/lifeos

LIFE_OS_CORS_ORIGINS=*
LIFE_OS_MEDIA_PATH=/tmp/lifeos_media
LIFE_OS_MAX_UPLOAD_MB=25
LIFE_OS_TOKEN_EXPIRE_MINUTES=10080

# Optional LLM (OpenAI-compatible)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# LIFE_OS_AI_PROVIDER=auto
